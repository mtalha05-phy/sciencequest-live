# ==============================================================================
# ScienceQuest Live - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file with secrets to version control!

# --- Application Server Configuration ---
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# --- Twitch Integration ---
# When SIMULATION_MODE is true, the game runs locally with simulated Twitch chat.
# When SIMULATION_MODE is false, it connects to live Twitch IRC chat via WebSockets.
SIMULATION_MODE=true
TWITCH_CHANNEL=
TWITCH_BOT_NICKNAME=ScienceQuestBot

# Twitch Developer Console OAuth Credentials (from https://dev.twitch.tv/console/apps)
# Client Type: Confidential
# OAuth Redirect URL to enter in Twitch Console: http://localhost:8000/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/auth/twitch/callback

# Direct OAuth Token (Optional if using web OAuth flow):
TWITCH_OAUTH_TOKEN=

# --- Quark AI Companion (OpenAI) ---
# Optional: If provided, Quark uses OpenAI to answer freeform chat questions.
# If omitted or unavailable, Quark automatically uses high-fidelity local scientific responses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
